/*
  X-Robots-Tag: noindex, nofollow, noarchive, noimageindex

# Vite fingerprints these files, so a new deployment always receives a new URL.
# HTML keeps Cloudflare Pages' default revalidation behavior, and Pages
# Functions attach their own headers because _headers does not apply to them.
/assets/*
  Cache-Control: public, max-age=31556952, immutable
